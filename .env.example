# ============================================================================
# Copy file này thành `.env` ở thư mục gốc: cp .env.example .env
#
# File `.env` phục vụ HAI mục đích khác nhau, đừng lẫn lộn:
#
#   [A] docker compose TỰ ĐỘNG đọc `.env` để nội suy các ${VAR} trong
#       docker-compose.yml. Mọi biến ở mục A dưới đây đều có default an toàn,
#       nên không có `.env` thì stack vẫn chạy đúng.
#
#   [B] Khi chạy service TRỰC TIẾP trên máy (không qua Docker), chính process
#       Node/Go đọc các biến ở mục B. docker compose KHÔNG dùng mục B — trong
#       Docker, giá trị được truyền tường minh qua `environment:` với hostname
#       nội bộ (postgres, kafka, rabbitmq...).
# ============================================================================


# ============================================================================
# [A] BIẾN DOCKER COMPOSE NỘI SUY
# ============================================================================

# ---- Cổng phía HOST ----
# Đổi ở đây nếu cổng đang bị chiếm, thay vì sửa docker-compose.yml.
GATEWAY_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
RABBITMQ_UI_HOST_PORT=15672

# ---- Credentials ----
# Dùng chung cho container hạ tầng và cho DATABASE_URL/RABBITMQ_URL mà compose
# dựng ra cho từng service -> đổi một chỗ là đổi tất cả.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ---- Logging ----
LOG_LEVEL=info

# ---- Núm vặn để demo (đổi rồi `docker compose up -d <service>` là có hiệu lực) ----
# Tỉ lệ lỗi giả lập của payment gateway. Đặt 1.0 để xem Saga rollback,
# 0 để luôn thành công.
PAYMENT_FAILURE_RATE=0.2
PAYMENT_MAX_RETRIES=3

# Tỉ lệ lỗi giả lập khi gửi email, để demo retry + Dead Letter Queue.
EMAIL_FAILURE_RATE=0.1
NOTIFICATION_MAX_RETRIES=3

# ---- gRPC deadline ----
# Không đặt deadline thì một service treo (không crash, chỉ không trả lời) sẽ
# làm Saga đứng vĩnh viễn và compensation không bao giờ chạy.
#
# Ngân sách thời gian phải LỒNG NHAU từ ngoài vào trong:
#   gateway CreateOrder (45s) > saga trong order-service (~40s worst case)
#     -> user/product (5s mỗi cái) + payment (15s) + refund compensation (15s)
#
# GRPC_PAYMENT_TIMEOUT_MS phải lớn hơn worst case của payment-service, vốn tự
# retry bên trong: PAYMENT_MAX_RETRIES(3) x delay(<=2s) + backoff(1s+2s) ~ 9s.
GRPC_TIMEOUT_MS=5000
GRPC_PAYMENT_TIMEOUT_MS=15000
GRPC_CREATE_ORDER_TIMEOUT_MS=45000


# ============================================================================
# [B] CHẠY SERVICE TRỰC TIẾP TRÊN MÁY (không qua Docker)
#
# Vẫn cần `docker compose up -d postgres kafka rabbitmq` để có hạ tầng.
# Lưu ý: topology RabbitMQ/Kafka do rabbitmq-init và kafka-init tạo, nên hãy
# chạy `docker compose up rabbitmq-init kafka-init` trước, nếu không service sẽ
# báo queue/topic không tồn tại.
# ============================================================================

NODE_ENV=development

# Mỗi service một database riêng (database-per-service).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/orderdb
# userdb | productdb | orderdb | paymentdb | analyticsdb — đổi theo service đang chạy.

# gRPC endpoint khi mọi thứ chạy trên localhost.
USER_SERVICE_URL=localhost:50051
PRODUCT_SERVICE_URL=localhost:50052
ORDER_SERVICE_URL=localhost:50053
PAYMENT_SERVICE_URL=localhost:50054

# Broker.
KAFKA_BROKERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Cổng service tự bind.
GATEWAY_PORT=3000
